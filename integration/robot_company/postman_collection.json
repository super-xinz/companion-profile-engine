{
  "info": {
    "name": "Companion Profile Engine - B2B",
    "description": "画像引擎服务端接入集合。集合不包含真实凭据；请只在受控的 B 端开发环境中填写变量。正常联调依次执行 01-04。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://replace-with-delivered-domain" },
    { "key": "tenantId", "value": "replace-with-delivered-tenant-id" },
    { "key": "apiKey", "value": "replace-via-secure-channel", "type": "secret" },
    { "key": "userId", "value": "b2b-postman-user-001" },
    { "key": "sessionId", "value": "b2b-session-001" },
    { "key": "turnId", "value": "b2b-turn-001" },
    { "key": "profileVersion", "value": "1" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "description": "无需鉴权。status 必须为 ok，database 必须为 ok。"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('service and database are healthy', function () {",
          "  pm.response.to.have.status(200);",
          "  const body = pm.response.json();",
          "  pm.expect(body.status).to.eql('ok');",
          "  pm.expect(body.services.database).to.eql('ok');",
          "});"
        ] }
      }]
    },
    {
      "name": "02 Initialize profile",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Tenant-ID", "value": "{{tenantId}}" },
          { "key": "Idempotency-Key", "value": "init:{{userId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant_user_id\": \"{{userId}}\",\n  \"display_name\": \"B2B Postman User\",\n  \"consent\": {\n    \"profile\": true,\n    \"sensitive_inference\": false\n  }\n}"
        },
        "url": "{{baseUrl}}/v1/profiles:init",
        "description": "用户首次明确开启画像时调用。相同 userId 和相同幂等键可安全重发。"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('profile initialized', function () {",
          "  pm.response.to.have.status(200);",
          "  const body = pm.response.json();",
          "  pm.expect(body.profile_version).to.eql(1);",
          "  pm.collectionVariables.set('profileVersion', String(body.profile_version));",
          "});"
        ] }
      }]
    },
    {
      "name": "03 Get current profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
        "url": "{{baseUrl}}/v1/profiles/{{userId}}",
        "description": "每次新写操作前可先执行本请求，以取得最新 profileVersion。"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('profile loaded', function () {",
          "  pm.response.to.have.status(200);",
          "  const body = pm.response.json();",
          "  pm.collectionVariables.set('profileVersion', String(body.profile_version));",
          "});"
        ] }
      }]
    },
    {
      "name": "04 Ingest one user message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Tenant-ID", "value": "{{tenantId}}" },
          { "key": "Idempotency-Key", "value": "{{turnId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation_id\": \"{{sessionId}}\",\n  \"message_id\": \"{{turnId}}\",\n  \"expected_profile_version\": {{profileVersion}},\n  \"occurred_at\": \"2026-08-07T08:00:00Z\",\n  \"text\": \"以后回答短一点，先听我把话说完。\",\n  \"context\": {\n    \"topic\": \"communication\",\n    \"previous_turn_count\": 0,\n    \"recent_turns\": []\n  }\n}"
        },
        "url": "{{baseUrl}}/v1/profiles/{{userId}}/messages:ingest",
        "description": "重发同一 turn 时，turnId、profileVersion、occurred_at 和 body 都必须保持不变。发送新消息前先执行 03，并更换 turnId。"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('message accepted', function () {",
          "  pm.response.to.have.status(200);",
          "  const body = pm.response.json();",
          "  pm.expect(body).to.have.property('reply_hints');",
          "  pm.expect(body).to.have.property('profile_version');",
          "});"
        ] }
      }]
    },
    {
      "name": "User rights (run individually)",
      "description": "这些请求不是正常聊天链路。执行写操作前先运行 03 获取最新版本。Forget all profile 会关闭画像推断。",
      "item": [
        {
          "name": "Explain profile evidence",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": "{{baseUrl}}/v1/profiles/{{userId}}/explain?field=core_traits.energy_mode.extroversion"
          }
        },
        {
          "name": "Correct one core trait",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" },
              { "key": "Idempotency-Key", "value": "correct:{{userId}}:001" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_profile_version\": {{profileVersion}},\n  \"target_path\": \"core_traits.energy_mode.extroversion\",\n  \"value\": 0.7,\n  \"reason\": \"用户明确更正\"\n}"
            },
            "url": "{{baseUrl}}/v1/profiles/{{userId}}:correct"
          }
        },
        {
          "name": "Forget all profile data",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-ID", "value": "{{tenantId}}" },
              { "key": "Idempotency-Key", "value": "forget-all:{{userId}}:001" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_profile_version\": {{profileVersion}},\n  \"scope\": \"all_profile\",\n  \"reason\": \"用户撤回画像授权\"\n}"
            },
            "url": "{{baseUrl}}/v1/profiles/{{userId}}:forget",
            "description": "破坏性操作：只在用户明确撤回授权时调用。"
          }
        }
      ]
    },
    {
      "name": "Operations",
      "item": [
        {
          "name": "Current rule pack",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": "{{baseUrl}}/v1/rule-packs/current"
          }
        }
      ]
    }
  ]
}
