  "components": {
    "schemas": {
      "Consent": {
        "properties": {
          "profile": {
            "type": "boolean",
            "title": "Profile"
          },
          "sensitive_inference": {
            "type": "boolean",
            "title": "Sensitive Inference",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "profile"
        ],
        "title": "Consent"
      },
      "ConversationTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ConversationTurn"
      },
      "CorrectionRequest": {
        "properties": {
          "expected_profile_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Profile Version"
          },
          "target_path": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Target Path"
          },
          "value": {
            "title": "Value"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "expected_profile_version",
          "target_path",
          "value",
          "reason"
        ],
        "title": "CorrectionRequest"
      },
      "EnneagramIdentityInput": {
        "properties": {
          "core_type": {
            "type": "integer",
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Core Type"
          },
          "wing": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Wing"
          },
          "primary_instinct": {
            "type": "string",
            "enum": [
              "SP",
              "SX",
              "SO"
            ],
            "title": "Primary Instinct"
          },
          "secondary_instinct": {
            "type": "string",
            "enum": [
              "SP",
              "SX",
              "SO"
            ],
            "title": "Secondary Instinct"
          },
          "source": {
            "type": "string",
            "enum": [
              "user_supplied",
              "external_assessment",
              "expert_confirmed"
            ],
            "title": "Source",
            "default": "user_supplied"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 0.8
          }
        },
        "type": "object",
        "required": [
          "core_type",
          "primary_instinct",
          "secondary_instinct"
        ],
        "title": "EnneagramIdentityInput"
      },
      "ForgetRequest": {
        "properties": {
          "expected_profile_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Profile Version"
          },
          "scope": {
            "type": "string",
            "enum": [
              "memory",
              "evidence",
              "birth_inference",
              "enneagram",
              "all_profile"
            ],
            "title": "Scope"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "expected_profile_version",
          "scope",
          "reason"
        ],
        "title": "ForgetRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageContext": {
        "properties": {
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          },
          "previous_turn_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Previous Turn Count",
            "default": 0
          },
          "recent_turns": {
            "items": {
              "$ref": "#/components/schemas/ConversationTurn"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Recent Turns"
          }
        },
        "type": "object",
        "title": "MessageContext"
      },
      "MessageIngestRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "message_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Message Id"
          },
          "expected_profile_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Profile Version"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "context": {
            "$ref": "#/components/schemas/MessageContext"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "message_id",
          "expected_profile_version",
          "occurred_at",
          "text"
        ],
        "title": "MessageIngestRequest"
      },
      "ProfileInitRequest": {
        "properties": {
          "tenant_user_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Tenant User Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "birth_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date"
          },
          "birth_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Time"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          },
          "enneagram": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EnneagramIdentityInput"
              },
              {
                "type": "null"
              }
            ]
          },
          "consent": {
            "$ref": "#/components/schemas/Consent"
          }
        },
        "type": "object",
        "required": [
          "tenant_user_id",
          "consent"
        ],
        "title": "ProfileInitRequest"
      },
      "SetEnneagramRequest": {
        "properties": {
          "expected_profile_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Profile Version"
          },
          "enneagram": {
            "$ref": "#/components/schemas/EnneagramIdentityInput"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "expected_profile_version",
          "enneagram",
          "reason"
        ],
        "title": "SetEnneagramRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "RulePackSummary": {
        "type": "object",
        "required": [
          "version",
          "sha256",
          "status"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "services"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
